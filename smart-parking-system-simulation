        "\n",
        "# Smart Parking System - Step 1\n",
        "\n",
        "# Simulated sensors: 0 = free, 1 = occupied\n",
        "parking_sensors = {\n",
        "    \"P1\": 0,\n",
        "    \"P2\": 1,\n",
        "    \"P3\": 0,\n",
        "    \"P4\": 1,\n",
        "    \"P5\": 0\n",
        "}\n",
        "\n",
        "# Display the parking status\n",
        "available_spaces = 0\n",
        "occupied_spaces = 0\n",
        "\n",
        "for space, sensor in parking_sensors.items():\n",
        "    if sensor == 0:\n",
        "        print(f\"{space}: FREE 🟢\")\n",
        "        available_spaces += 1\n",
        "    else:\n",
        "        print(f\"{space}: OCCUPIED 🔴\")\n",
        "        occupied_spaces += 1\n",
        "\n",
        "print(\"\\n--- PARKING SUMMARY ---\")\n",
        "print(\"Total spaces:\", len(parking_sensors))\n",
        "print(\"Available spaces:\", available_spaces)\n",
        "print(\"Occupied spaces:\", occupied_spaces)\n"
      ]
