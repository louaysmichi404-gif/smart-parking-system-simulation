        "\n",
        "def update_dashboard(_=None):\n",
        "    clear_output(wait=True)\n",
        "\n",
        "    available = list(parking_sensors.values()).count(0)\n",
        "    occupied = len(parking_sensors) - available\n",
        "\n",
        "    print(\"SMART PARKING SYSTEM — IoT MONITOR\")\n",
        "    print(f\"Available: {available} | Occupied: {occupied}\")\n",
        "\n",
        "    fig, ax = plt.subplots(figsize=(9, 2.5))\n",
        "\n",
        "    for i, (space, sensor) in enumerate(parking_sensors.items()):\n",
        "        color = \"seagreen\" if sensor == 0 else \"firebrick\"\n",
        "        ax.add_patch(plt.Rectangle((i, 0), 0.9, 1,\n",
