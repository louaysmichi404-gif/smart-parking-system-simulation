
import random
import matplotlib.pyplot as plt
from IPython.display import display, clear_output
import ipywidgets as widgets

# Simulated parking sensors: 0 = free, 1 = occupied
parking_sensors = {
    "P1": 0,
    "P2": 1,
    "P3": 0,
    "P4": 1,
    "P5": 0
}

def update_dashboard(_=None):
    clear_output(wait=True)

    available = list(parking_sensors.values()).count(0)
    occupied = len(parking_sensors) - available

    print("SMART PARKING SYSTEM — IoT MONITOR")
    print(f"Available: {available} | Occupied: {occupied}")

    fig, ax = plt.subplots(figsize=(9, 2.5))

    for i, (space, sensor) in enumerate(parking_sensors.items()):
        color = "seagreen" if sensor == 0 else "firebrick"
        ax.add_patch(plt.Rectangle((i, 0), 0.9, 1,
                                   facecolor=color))
        status = "FREE" if sensor == 0 else "OCCUPIED"
        ax.text(i + 0.45, 0.5, f"{space}\n{status}",
                color="white", ha="center", va="center",
                fontweight="bold", fontsize=9)

    ax.set_xlim(-0.1, len(parking_sensors))
    ax.set_ylim(-0.1, 1.2)
    ax.axis("off")
    plt.show()

    display(arrival_button, departure_button, refresh_button)

def simulate_arrival(_):
    free_spaces = [s for s in parking_sensors
                   if parking_sensors[s] == 0]
    if free_spaces:
        space = random.choice(free_spaces)
        parking_sensors[space] = 1
        print(f"Car arrived: {space}")
    else:
        print("Parking is full!")

    update_dashboard()

def simulate_departure(_):
    occupied_spaces = [s for s in parking_sensors
                       if parking_sensors[s] == 1]
    if occupied_spaces:
        space = random.choice(occupied_spaces)
        parking_sensors[space] = 0
        print(f"Car left: {space}")
    else:
        print("No cars are parked.")

    update_dashboard()

def refresh_sensors(_):
    update_dashboard()

arrival_button = widgets.Button(
    description="Simulate car arrival",
    button_style="success"
)
departure_button = widgets.Button(
    description="Simulate car departure",
    button_style="danger"
)
refresh_button = widgets.Button(
    description="Refresh dashboard"
)

arrival_button.on_click(simulate_arrival)
departure_button.on_click(simulate_departure)
refresh_button.on_click(refresh_sensors)

update_dashboard()
