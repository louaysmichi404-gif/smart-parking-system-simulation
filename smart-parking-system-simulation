        "        \"timestamp\": datetime.now().isoformat(timespec=\"seconds\")\n",
        "    }\n",
        "\n",
        "    topic = f\"smartparking/{space_id}/status\"\n",
        "\n",
        "    print(\"Topic:\", topic)\n",
        "    print(\"Message:\", json.dumps(message, indent=2))\n",
        "    print(\"-\" * 40)\n",
        "\n",
        "# Simulate messages from three parking sensors\n",
